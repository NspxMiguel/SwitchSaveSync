{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "x-robots-tag", "value": "noindex" },
        { "key": "referrer-policy", "value": "no-referrer" }
      ]
    }
  ]
}
